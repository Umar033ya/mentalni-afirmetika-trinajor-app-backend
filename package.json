{
  "name": "mental-arifmetika-backend",
  "version": "1.0.0",
  "description": "Complete backend for the Mental Arithmetic app: auth, users, practice, duels, progression, cosmetics, subscriptions and more.",
  "main": "dist/server.js",
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "node scripts/setup-env.mjs && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node scripts/setup-env.mjs && node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
