PORT=5000
NODE_ENV=development

# ----------------------------------------------------------------------------
# Supabase (Dashboard -> Project Settings -> API)
# SERVER ONLY: SUPABASE_SERVICE_ROLE_KEY must NEVER be placed in Expo/frontend.
# Get these two real values from your own Supabase project.
# ----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JWT (a strong development secret is generated automatically by `npm run dev`
# if this is left empty)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS origin(s) of the Expo app. Comma-separate multiple origins.
# Do NOT use * in production.
CLIENT_URL=http://localhost:8081

# Rate limiting (optional)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
